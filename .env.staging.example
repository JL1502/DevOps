# Copy to .env.staging and fill in privately. NEVER commit .env.staging.
APP_NAME="Request System Staging"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
# Create once and keep it across releases. Do not regenerate.
APP_KEY=
LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_staging_db
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=laravel_request_staging_db
MYSQL_USER=CHANGE_ME_DB_USER
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
