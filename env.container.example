# Copy to .env.container and fill in values privately. NEVER commit .env.container.
APP_NAME="Request System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
# Generate once: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Read by the official MySQL image on first start
MYSQL_DATABASE=laravel_request_container_db
MYSQL_USER=CHANGE_ME_DB_USER
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Optional: change when reproducing on the same computer
WEB_PORT=8080
COMPOSE_PROJECT_NAME=laravel-request
